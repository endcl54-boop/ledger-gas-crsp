{
  "name": "ledger-gas-crsp",
  "version": "0.1.0",
  "private": true,
  "description": "Google Apps Script TypeScript ledger web app deployed with Rust crsp",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "node tools/build.mjs",
    "crsp:status": "crsp show-file-status",
    "crsp:push": "npm run build && crsp push"
  },
  "devDependencies": {
    "@types/google-apps-script": "^2.0.13",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
